---
import Layout from '../layouts/Layout.astro';
import { read } from '../lib/content';

const { videos, description } = await read('videos');
---

<Layout title="Video" description={description} section="video">
  <main>
    <h1 class="page-title">Video</h1>
    <div class="video-grid measure">
      {
        videos.map((v) => (
          <mux-player
            playback-id={v.muxPlaybackId}
            stream-type="on-demand"
            metadata-video-title={v.title}
            aria-label={v.title}
            preload="metadata"
          />
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .video-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding-top: 50px;
  }
  mux-player {
    display: block;
    width: 500px;
    max-width: 100%;
    aspect-ratio: 16 / 9;
  }
</style>

<script>
  import '@mux/mux-player';
</script>
